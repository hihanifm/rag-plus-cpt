# Copy to .env and fill in.  ( cp .env.example .env )

# --- Teacher (enrichment, QA generation) = OpenAI GPT ---
OPENAI_API_KEY=sk-...

# --- Gold drafting (optional) = a DIFFERENT model family, to avoid teaching-to-the-test ---
# If set, `review curate` uses Claude for gold. If NOT set, it falls back to the teacher (GPT).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Tuned-model endpoint (vLLM serving the Qwen3-14B run) for eval + chat ---
# Filled after `ragcpt serve` is up (Lambda H100 box). OpenAI-compatible.
# TUNED_BASE_URL=http://<lambda-host>:8000/v1
# TUNED_API_KEY=EMPTY

# --- Base Qwen3-14B endpoint for baseline eval (vLLM serving the untuned base) ---
# BASE_BASE_URL=http://<lambda-host>:8001/v1
# BASE_API_KEY=EMPTY
