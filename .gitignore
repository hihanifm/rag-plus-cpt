# --- secrets / env (keep .env.example tracked) ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- generated pipeline artifacts (evidence stays local) ---
data/*.jsonl
data/*.json
models/

# --- source docs + their metadata sidecars (proprietary, never publish) ---
docs/*
!docs/.gitkeep
**/*.meta.json

# --- OS / editor ---
.DS_Store
*.log
.vscode/
.idea/
